{
  "name": "@crescent/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json && electron .",
    "test": "jest",
    "configure:mac": "node scripts/configure.mjs",
    "configure:win": "node scripts/configure.mjs",
    "package:mac": "node scripts/package.mjs mac",
    "package:win": "node scripts/package.mjs win"
  },
  "devDependencies": {
    "electron": "^36.0.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.12",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@crescent/licensing": "0.1.0"
  },
  "jest": {
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "testEnvironment": "node",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    }
  }
}
