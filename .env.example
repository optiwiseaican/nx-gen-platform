# Server
PORT=4000
# Local:  postgresql://user:pass@localhost:5432/nxgen
# Hosted (TLS): append ?sslmode=require AND save the provider CA certificate as
#               apps/server/config/database-ca.pem (or set DATABASE_CA_CERT=/path/ca.pem).
#               The server always verifies the certificate; there is no insecure mode.
DATABASE_URL=postgresql://nxgen:nxgen_dev@localhost:5432/nxgen
NXGEN_DB_SCHEMA=nxgen
DEPLOYMENT_MODE=STANDALONE

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000
